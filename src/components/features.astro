---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "Controle Inteligente",
    description:
      "Sistema automatizado que monitora umidade do solo, clima e necessidades das plantas da sua horta para irrigação precisa.",
    icon: "bx:bxs-briefcase",
  },
  {
    title: "Economia de Água",
    description:
      "Tecnologia avançada que reduz o desperdício de água em até 40% comparado aos métodos tradicionais de irrigação.",
    icon: "bx:bxs-droplet",
  },
  {
    title: "Monitoramento 24/7",
    description:
      "Acompanhe sua horta em tempo real através de aplicativo móvel com alertas e relatórios detalhados.",
    icon: "bx:bxs-data",
  },
  {
    title: "Integração IoT",
    description:
      "Conecte sensores, válvulas e bombas em uma rede inteligente que se comunica e otimiza automaticamente.",
    icon: "bx:bxs-bot",
  },
  {
    title: "Análise de Dados",
    description:
      "Relatórios inteligentes que mostram produtividade da sua horta, consumo de água e recomendações para melhorar seus resultados.",
    icon: "bx:bxs-file-find",
  },
  {
    title: "Suporte Especializado",
    description:
      "Equipe técnica especializada em hortas inteligentes para garantir o melhor desempenho do seu sistema.",
    icon: "bx:bxs-user",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Tudo que você precisa para sua horta inteligente
  </h2>
  <p class="text-lg mt-4 text-slate-600">
    A IrrigaTech oferece soluções completas de irrigação inteligente para hortas
    pessoais e pequenos negócios verdes. Combinamos tecnologia de ponta com
    expertise em horticultura para maximizar seus resultados.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>

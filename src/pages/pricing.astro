---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
  {
    name: "Horta Pessoal",
    price: "Grátis",
    popular: false,
    features: [
      "Até 50m² de horta",
      "Monitoramento básico",
      "Relatórios simples",
      "Suporte por email",
      "App móvel básico",
      "Atualizações gratuitas",
    ],
    button: {
      text: "Começar",
      link: "/contact",
    },
  },
  {
    name: "Pequeno Negócio Verde",
    price: {
      monthly: "R$ 99",
      annual: "R$ 89",
      discount: "10%",
      original: "R$ 109",
    },
    popular: true,
    features: [
      "Até 500m² de área",
      "Controle inteligente",
      "Relatórios avançados",
      "Suporte prioritário",
      "App móvel completo",
      "Integração IoT",
    ],
    button: {
      text: "Começar",
      link: "/contact",
    },
  },
  {
    name: "Negócio Verde Escalável",
    price: "Personalizado",
    popular: false,
    features: [
      "Área ilimitada",
      "Sistema completo",
      "Relatórios customizados",
      "Suporte 24/7",
      "API personalizada",
      "Consultoria especializada",
    ],
    button: {
      text: "Fale conosco",
      link: "/contact",
    },
  },
];
---

<Layout title="Preços">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Preços</Fragment>
      <Fragment slot="desc">
        Preços simples e previsíveis para sua horta inteligente.
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>

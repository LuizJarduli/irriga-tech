---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import PricingCard from "@/components/pricing.astro";

const pricing = [
  {
    name: "Básico",
    price: "Grátis",
    popular: false,
    features: [
      "Até 1 hectare",
      "Monitoramento básico",
      "Relatórios simples",
      "Suporte por email",
      "App móvel básico",
      "Atualizações gratuitas",
    ],
    button: {
      text: "Começar",
      link: "/contato",
    },
  },
  {
    name: "Profissional",
    price: {
      monthly: "R$ 199",
      annual: "R$ 179",
      discount: "10%",
      original: "R$ 219",
    },
    popular: true,
    features: [
      "Até 10 hectares",
      "Controle inteligente",
      "Relatórios avançados",
      "Suporte prioritário",
      "App móvel completo",
      "Integração IoT",
    ],
    button: {
      text: "Começar",
      link: "/contato",
    },
  },
  {
    name: "Empresarial",
    price: "Personalizado",
    popular: false,
    features: [
      "Área ilimitada",
      "Sistema completo",
      "Relatórios customizados",
      "Suporte 24/7",
      "API personalizada",
      "Consultoria especializada",
    ],
    button: {
      text: "Fale conosco",
      link: "/contato",
    },
  },
];
---

<Layout title="Preços">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Preços</Fragment>
      <Fragment slot="desc">
        Preços simples e previsíveis. Sem surpresas.
      </Fragment>
    </Sectionhead>

    <div
      class="grid md:grid-cols-3 gap-10 mx-auto max-w-(--breakpoint-lg) mt-12">
      {pricing.map((item) => <PricingCard plan={item} />)}
    </div>
  </Container>
</Layout>
